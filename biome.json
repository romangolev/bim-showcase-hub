{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!.claude",
      "!.playwright-mcp",
      "!.vercel",
      "!e2e/output",
      "!e2e/.venv",
      "!e2e/.profile",
      "!node_modules",
      "!docs",
      "!package-lock.json",
      "!DESIGN.md"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["NumberField"] }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/web/viewer/viewerChrome.css"],
      "linter": {
        "rules": {
          "correctness": { "noUnknownTypeSelector": "off" },
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      "includes": ["src/web/**", "!src/web/ui/**", "!src/web/viewer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@base-ui/react", "@base-ui/react/**"],
                    "message": "Only src/web/ui imports Base UI. Use a primitive from src/web/ui. See docs/design-system.md, Import boundaries."
                  },
                  {
                    "group": [
                      "**/viewer/RealViewerAdapter.js",
                      "**/viewer/autodesk.js",
                      "**/viewer/autodeskTools.js",
                      "**/viewer/fakeFederatedViewer.js"
                    ],
                    "message": "Reach the viewer through ViewerAdapter and createViewerAdapter. See docs/design-system.md, Import boundaries."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/web/viewer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@base-ui/react", "@base-ui/react/**"],
                    "message": "Only src/web/ui imports Base UI. Use a primitive from src/web/ui. See docs/design-system.md, Import boundaries."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/web/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!react",
                      "!react/**",
                      "!@base-ui/react/**",
                      "!clsx",
                      "!tailwind-merge",
                      "!./**",
                      "**/../**"
                    ],
                    "message": "src/web/ui imports only react, @base-ui/react, clsx, tailwind-merge and its own files. See docs/design-system.md, Import boundaries."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/web/ui/**/*.test.ts", "src/web/ui/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!react",
                      "!react/**",
                      "!@base-ui/react/**",
                      "!clsx",
                      "!tailwind-merge",
                      "!./**",
                      "**/../**",
                      "!vitest",
                      "!@testing-library/**"
                    ],
                    "message": "src/web/ui imports only react, @base-ui/react, clsx, tailwind-merge and its own files. See docs/design-system.md, Import boundaries."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
