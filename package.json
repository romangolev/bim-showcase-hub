{
  "name": "bim-showcase-hub",
  "version": "2.0.0",
  "description": "BIM Showcase Hub built on Autodesk Platform Services",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "license": "MIT",
  "author": "Roman Golev",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:mock": "cross-env MOCK_APS=1 VITE_MOCK_APS=1 npm run dev",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "e2e:setup": "uv venv e2e/.venv --python 3.12 && uv pip install --python e2e/.venv/bin/python -r e2e/requirements.txt && e2e/.venv/bin/python -m camoufox fetch",
    "e2e:signin": "e2e/.venv/bin/python e2e/signin.py",
    "e2e:smoke": "e2e/.venv/bin/python e2e/smoke.py",
    "e2e:glb": "e2e/.venv/bin/python e2e/glb_revit.py",
    "e2e:ifc": "e2e/.venv/bin/python e2e/ifc_revit.py",
    "e2e:state": "e2e/.venv/bin/python e2e/state_revit.py",
    "e2e:ux": "e2e/.venv/bin/python e2e/ux_audit.py"
  },
  "dependencies": {
    "@aps_sdk/authentication": "^1.0.1",
    "@aps_sdk/data-management": "^1.1.4",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.1",
    "cookie-session": "^2.1.1",
    "dockview-react": "8.9.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
